{
    // ADDITIVE `via: source` bindings — each ADDS a build-from-source method to an existing core
    // component. `source` is second-to-last in driver-preference, so it NEVER wins a default;
    // select it with `configsys pin set <comp> source` (or a gentoo-ish `driver-preference:`).
    //
    // Recipe convention: clone `repo` at the tag formed from the discovered `version` +
    // `tag-prefix` (bare-versioned repos: no strip-v, empty prefix; `vX.Y.Z` repos: strip-v +
    // tag-prefix "v"), then `build:` produces the binary and installs it into $PREFIX/bin (so it
    // lands on PATH at ~/.local/bin, no alias). $PREFIX/$SRC/$VERSION/$ARCH are substituted.
    //
    // Verified subset (container-built) is noted per recipe; the rest are transcribed from each
    // project's own build docs.
    components: {

        // ----- Rust / cargo (needs `cargo` = the rust toolchain) --------------------------------
        // NOTE: `cargo` = the DISTRO rust (rust-all/cargo), which can be older than a project's
        // MSRV — Ubuntu 24.04 ships Rust 1.75, but ripgrep needs 1.96, so the build fails there
        // with a manifest/edition error. Build on a distro with recent Rust (Arch's 1.97 builds it
        // cleanly — verified), or supply a newer toolchain. Same toolchain-floor caveat as Go below.
        // ripgrep: bare-semver release tags; default build needs only cargo (PCRE2 is opt-in).
        // [VERIFIED: built ripgrep 15.2.0 on archlinux (rustc 1.97.1).]
        // (fd, bat — also clean `cargo build` recipes — are DEFERRED: they aren't in core yet, and
        // this plugin only ADDS `source` to components that already have a binary method, so
        // shipping them here would make them build-by-default. Add fd/bat to core routes.hu first
        // [fd: apt fd-find/dnf fd-find/pacman fd; bat: note Debian's `batcat` binary rename], then a
        // later batch adds their source alternative.)
        ripgrep: {
            install: [
                { via: source  repo: "https://github.com/BurntSushi/ripgrep"
                  version: { github: BurntSushi/ripgrep }  requires: cargo
                  build: "cargo build --release && install -Dm755 target/release/rg $PREFIX/bin/rg" }
            ]
        }
        // just: pure Rust cargo build (bare-semver tags; MSRV lives in the version-floors plugin).
        just: {
            install: [
                { via: source  repo: "https://github.com/casey/just"
                  version: { github: casey/just }  requires: cargo
                  build: "cargo build --release && install -Dm755 target/release/just $PREFIX/bin/just" }
            ]
        }
        // nushell (`nu`): the workspace root IS the `nu` package; default features use rustls (no
        // system openssl/pkg-config). `--bin nu` is belt-and-suspenders. Bare-version tags.
        nushell: {
            install: [
                { via: source  repo: "https://github.com/nushell/nushell"
                  version: { github: nushell/nushell }  requires: cargo
                  build: "cargo build --release --bin nu && install -Dm755 target/release/nu $PREFIX/bin/nu" }
            ]
        }
        // yazi: builds TWO binaries — `yazi` (yazi-fm) and `ya` (yazi-cli) — from the workspace.
        // `--locked` per upstream; pure-Rust crypto (no system openssl). vX.Y.Z tags.
        yazi: {
            install: [
                { via: source  repo: "https://github.com/sxyazi/yazi"
                  version: { github: sxyazi/yazi  strip-v: true }  tag-prefix: "v"  requires: cargo
                  build: "cargo build --release --locked && install -Dm755 target/release/yazi $PREFIX/bin/yazi && install -Dm755 target/release/ya $PREFIX/bin/ya" }
            ]
        }
        // helix DEFERRED — the recipe (cargo install helix-term + auto tree-sitter grammars +
        // symlink $SRC/runtime -> $PREFIX/bin/runtime) is otherwise correct, but helix's build
        // AUTO-FETCHES its grammar repos and a single rotted upstream (e.g. `gotmpl`, which prompts
        // for github auth and fails) breaks the WHOLE build — with no clean declarative workaround
        // (`hx --grammar fetch` fails on the same repo). This grammar-repo fragility is exactly the
        // "gnarly build" that warrants a bespoke plugin (like blender/kicad), not a data recipe.

        // ----- Go (needs `go`) ------------------------------------------------------------------
        // NOTE: `go` installs the DISTRO Go (golang-go/golang), which can be older than these
        // projects' go.mod floor — lazygit needs Go >= 1.25, superfile >= 1.26. On a distro whose
        // packaged Go is older the build fails clearly; use a distro with a recent Go (Arch, or a
        // current Fedora), or a newer Go toolchain. Static builds (CGO_ENABLED=0), main pkg at root.
        // [VERIFIED: built lazygit on archlinux (recent Go).]
        lazygit: {
            install: [
                { via: source  repo: "https://github.com/jesseduffield/lazygit"
                  version: { github: jesseduffield/lazygit  strip-v: true }  tag-prefix: "v"  requires: go
                  build: "CGO_ENABLED=0 go build -o lazygit . && install -Dm755 lazygit $PREFIX/bin/lazygit" }
            ]
        }
        superfile: {
            install: [
                { via: source  repo: "https://github.com/yorukot/superfile"
                  version: { github: yorukot/superfile  strip-v: true }  tag-prefix: "v"  requires: go
                  build: "CGO_ENABLED=0 go build -o spf . && install -Dm755 spf $PREFIX/bin/spf" }
            ]
        }
        // fzf: a plain Go build straight into the prefix (folded from core). Bare-version tags.
        fzf: {
            install: [
                { via: source  repo: "https://github.com/junegunn/fzf"
                  version: { github: junegunn/fzf }  requires: go
                  build: "mkdir -p $PREFIX/bin && go build -o $PREFIX/bin/fzf" }
            ]
        }
        // lazydocker / lazysql / k9s: single-module pure-Go tools, main pkg at the repo root.
        // (k9s wants a recent Go — its go.mod floor is high; the version-floors plugin tracks it.)
        lazydocker: {
            install: [
                { via: source  repo: "https://github.com/jesseduffield/lazydocker"
                  version: { github: jesseduffield/lazydocker  strip-v: true }  tag-prefix: "v"  requires: go
                  build: "CGO_ENABLED=0 go build -o lazydocker . && install -Dm755 lazydocker $PREFIX/bin/lazydocker" }
            ]
        }
        lazysql: {
            install: [
                { via: source  repo: "https://github.com/jorgerojas26/lazysql"
                  version: { github: jorgerojas26/lazysql  strip-v: true }  tag-prefix: "v"  requires: go
                  build: "CGO_ENABLED=0 go build -o lazysql . && install -Dm755 lazysql $PREFIX/bin/lazysql" }
            ]
        }
        k9s: {
            install: [
                { via: source  repo: "https://github.com/derailed/k9s"
                  version: { github: derailed/k9s  strip-v: true }  tag-prefix: "v"  requires: go
                  build: "CGO_ENABLED=0 go build -o k9s . && install -Dm755 k9s $PREFIX/bin/k9s" }
            ]
        }
        // opentofu (`tofu`): main at ./cmd/tofu. High go.mod floor (patch-pinned ~1.26) — the
        // version-floors plugin tracks it, and a floor advisory points at `go tarball` if the
        // distro Go is older.
        opentofu: {
            install: [
                { via: source  repo: "https://github.com/opentofu/opentofu"
                  version: { github: opentofu/opentofu  strip-v: true }  tag-prefix: "v"  requires: go
                  build: "CGO_ENABLED=0 go build -o tofu ./cmd/tofu && install -Dm755 tofu $PREFIX/bin/tofu" }
            ]
        }
        // bazelisk: main at the repo ROOT (not ./cmd). grpcurl: main at ./cmd/grpcurl.
        bazelisk: {
            install: [
                { via: source  repo: "https://github.com/bazelbuild/bazelisk"
                  version: { github: bazelbuild/bazelisk  strip-v: true }  tag-prefix: "v"  requires: go
                  build: "CGO_ENABLED=0 go build -o bazelisk . && install -Dm755 bazelisk $PREFIX/bin/bazelisk" }
            ]
        }
        grpcurl: {
            install: [
                { via: source  repo: "https://github.com/fullstorydev/grpcurl"
                  version: { github: fullstorydev/grpcurl  strip-v: true }  tag-prefix: "v"  requires: go
                  build: "CGO_ENABLED=0 go build -o grpcurl ./cmd/grpcurl && install -Dm755 grpcurl $PREFIX/bin/grpcurl" }
            ]
        }
        // helm: main at ./cmd/helm. Plain build (no version ldflags) — the version vars have safe
        // in-source defaults, so `helm version` is cosmetic-only and it's v3/v4-agnostic. High go
        // floor (~1.26). vX.Y.Z tags.
        helm: {
            install: [
                { via: source  repo: "https://github.com/helm/helm"
                  version: { github: helm/helm  strip-v: true }  tag-prefix: "v"  requires: go
                  build: "CGO_ENABLED=0 go build -trimpath -o helm ./cmd/helm && install -Dm755 helm $PREFIX/bin/helm" }
            ]
        }

        // ----- C / C++ (make + cmake) -----------------------------------------------------------
        // btop: C++ Makefile, installs under the prefix. Folded from core; latest release tag.
        btop: {
            install: [
                { via: source  repo: "https://github.com/aristocratos/btop"
                  version: { github: aristocratos/btop }  requires: [ cxx, make ]
                  build: "make && make install PREFIX=$PREFIX" }
            ]
        }
        // fastfetch: CMake; optional feature libs are auto-detected/skipped. Folded from core.
        fastfetch: {
            install: [
                { via: source  repo: "https://github.com/fastfetch-cli/fastfetch"
                  version: { github: fastfetch-cli/fastfetch }  requires: [ cc, cmake ]
                  build: "cmake -B build -DCMAKE_INSTALL_PREFIX=$PREFIX && cmake --build build && cmake --install build" }
            ]
        }
        // neovim: bundles its own deps (libuv/luajit/tree-sitter/...) — the top-level Makefile builds
        // them first, so it needs only a C/C++ toolchain + cmake/ninja + gettext (libintl) and
        // curl/unzip (to fetch the bundled dep sources). Adds a `source` method beside core's appImage.
        // vX.Y.Z tags. [VERIFIED: built NVIM v0.12.4 on fedora:41.]
        neovim: {
            install: [
                { via: source  repo: "https://github.com/neovim/neovim"
                  version: { github: neovim/neovim  strip-v: true }  tag-prefix: "v"
                  requires: [ cc, cxx, cmake, ninja, make, gettext, curl, unzip ]
                  build: "make CMAKE_BUILD_TYPE=Release CMAKE_INSTALL_PREFIX=$PREFIX && make install" }
            ]
        }
        // nethogs: C++ Makefile; needs libpcap (packet capture) + ncurses. Its `make install` drops the
        // binary in $PREFIX/sbin, so install the built `src/nethogs` into $PREFIX/bin ourselves (on
        // PATH). Runs as root (raw sockets) but builds unprivileged. vX.Y.Z tags.
        // [VERIFIED: built on fedora:41 (libpcap-devel + ncurses-devel).]
        nethogs: {
            install: [
                { via: source  repo: "https://github.com/raboof/nethogs"
                  version: { github: raboof/nethogs  strip-v: true }  tag-prefix: "v"
                  requires: [ cc, cxx, make, ncurses, libpcap ]
                  build: "make && install -Dm755 src/nethogs $PREFIX/bin/nethogs" }
            ]
        }
        // ninja: tiny C++ build tool — cmake build (bootstraps itself). vX.Y.Z tags.
        // [VERIFIED: built ninja 1.14 on fedora:41.]
        ninja: {
            install: [
                { via: source  repo: "https://github.com/ninja-build/ninja"
                  version: { github: ninja-build/ninja  strip-v: true }  tag-prefix: "v"
                  requires: [ cxx, cmake, make ]
                  build: "cmake -B build -DCMAKE_INSTALL_PREFIX=$PREFIX -DCMAKE_BUILD_TYPE=Release && cmake --build build && cmake --install build" }
            ]
        }
        // protobuf (protoc): cmake build; vendors abseil as a git submodule (`--init` first,
        // ABSL_PROVIDER=module), tests off. vX.Y.Z tags. [VERIFIED: built libprotoc on fedora:41.]
        protobuf: {
            install: [
                { via: source  repo: "https://github.com/protocolbuffers/protobuf"
                  version: { github: protocolbuffers/protobuf  strip-v: true }  tag-prefix: "v"
                  requires: [ cc, cxx, cmake, make ]
                  build: "git submodule update --init --recursive && cmake -B build -DCMAKE_INSTALL_PREFIX=$PREFIX -Dprotobuf_BUILD_TESTS=OFF -Dprotobuf_ABSL_PROVIDER=module && cmake --build build && cmake --install build" }
            ]
        }
        // whois: Marco d'Itri's whois (the `whois` on Debian). Plain Makefile; needs libidn2 (IDN) +
        // perl (generates its TLD-server table) + gettext (msgfmt). Publishes NO github Releases (git
        // tags only), so pin statically (ref = v + version). [VERIFIED: built on fedora:41.]
        whois: {
            install: [
                { via: source  version: { static: "5.6.6" }  tag-prefix: "v"
                  repo: "https://github.com/rfc1036/whois"
                  requires: [ cc, make, perl, libidn2, gettext ]
                  build: "make && make install prefix=$PREFIX" }
            ]
        }
        // cmake: bootstraps itself (./bootstrap uses the system compiler + bundled deps), then make.
        // Slow (~10 min). vX.Y.Z tags. [VERIFIED: built cmake 4.4 on fedora:41.]
        cmake: {
            install: [
                { via: source  repo: "https://github.com/Kitware/CMake"
                  version: { github: Kitware/CMake  strip-v: true }  tag-prefix: "v"
                  requires: [ cc, cxx, make ]
                  build: "./bootstrap --prefix=$PREFIX --parallel=$(nproc) && make -j$(nproc) && make install" }
            ]
        }

        // ----- C / autotools (git checkout -> autogen -> configure -> make) ---------------------
        // htop: only hard dev-lib dep is ncurses (wide); sensors/capabilities/delayacct auto-skip
        // if their headers are absent. `make uninstall` cleans the prefix. Bare-version tags.
        // [VERIFIED: built htop on fedora:41 (ncurses-devel + pkgconf-pkg-config name maps).]
        htop: {
            install: [
                { via: source  repo: "https://github.com/htop-dev/htop"
                  version: { github: htop-dev/htop }
                  requires: [ cc, make, autoconf, automake, pkg-config, ncurses ]
                  build: "./autogen.sh && ./configure --prefix=$PREFIX && make && make install"
                  uninstall-cmd: "make uninstall" }
            ]
        }
        // tmux: needs libevent + ncurses, and a yacc (bison) for its grammar. `sh autogen.sh`
        // (not ./autogen.sh) per upstream. Bare-version tags (e.g. 3.7, 3.7a).
        tmux: {
            install: [
                { via: source  repo: "https://github.com/tmux/tmux"
                  version: { github: tmux/tmux }
                  requires: [ cc, make, autoconf, automake, pkg-config, bison, ncurses, libevent ]
                  build: "sh autogen.sh && ./configure --prefix=$PREFIX && make && make install"
                  uninstall-cmd: "make uninstall" }
            ]
        }
        // jq: autotools, but a git checkout ships no `configure` (regenerate with autoreconf) and
        // its oniguruma is a vendored SUBMODULE — init it first, then `--with-oniguruma=builtin`
        // (no system libonig). The regenerated parser/lexer need bison>=3 + flex. Tags are
        // `jq-X.Y.Z`, and the discovered tag_name IS that full ref, so no tag-prefix / strip-v.
        jq: {
            install: [
                { via: source  repo: "https://github.com/jqlang/jq"
                  version: { github: jqlang/jq }
                  requires: [ cc, make, autoconf, automake, libtool, bison, flex ]
                  build: "git submodule update --init && autoreconf -fi && ./configure --prefix=$PREFIX --with-oniguruma=builtin --disable-maintainer-mode && make && make install"
                  uninstall-cmd: "make uninstall" }
            ]
        }
        // mtr: autotools via ./bootstrap.sh. Installs mtr/mtr-packet as sbin_PROGRAMS, so force
        // --sbindir=$PREFIX/bin to land them on PATH; --without-gtk keeps it TUI-only (ncurses).
        // (Raw-socket perms are a runtime concern for ANY userland mtr — run via sudo or setcap.)
        mtr: {
            install: [
                { via: source  repo: "https://github.com/traviscross/mtr"
                  version: { github: traviscross/mtr  strip-v: true }  tag-prefix: "v"
                  requires: [ cc, make, autoconf, automake, pkg-config, ncurses ]
                  build: "./bootstrap.sh && ./configure --prefix=$PREFIX --sbindir=$PREFIX/bin --without-gtk && make && make install"
                  uninstall-cmd: "make uninstall" }
            ]
        }
        // curl: autotools; a git checkout has no configure (autoreconf -fi first). System OpenSSL +
        // zlib for HTTP/HTTPS; --without-libpsl (since 7.81 configure errors without a psl decision).
        // Its tag is `curl-<version, dots→underscores>` and the discovered tag_name IS that full ref
        // (so no tag-prefix / strip-v — the resolver checks out tag_name verbatim).
        curl: {
            install: [
                { via: source  repo: "https://github.com/curl/curl"
                  version: { github: curl/curl }
                  requires: [ cc, make, pkg-config, autoconf, automake, libtool, openssl, zlib ]
                  build: "autoreconf -fi && ./configure --prefix=$PREFIX --with-openssl --with-zlib --without-libpsl && make && make install"
                  uninstall-cmd: "make uninstall" }
            ]
        }
        // git: hand-written Makefile (NO autotools) — plain `make prefix=` is the documented path;
        // NO_TCLTK skips the gitk/git-gui GUIs. HTTPS clone auto-detects libcurl at build time, so
        // it's a HARD `requires:` here (configsys installs the dev-libs before the build, turning a
        // silent no-HTTPS build into "won't resolve"). expat=http-push, gettext=i18n, perl=tooling.
        // (No `make uninstall` — the source driver removes the prefix tree.) vX.Y.Z tags.
        git: {
            install: [
                { via: source  repo: "https://github.com/git/git"
                  version: { github: git/git  strip-v: true }  tag-prefix: "v"
                  requires: [ cc, make, zlib, libcurl, openssl, expat, gettext, perl ]
                  build: "make -j$(nproc) prefix=$PREFIX NO_TCLTK=1 all && make prefix=$PREFIX NO_TCLTK=1 install" }
            ]
        }
        // nmap: its github repo is a TAGLESS SVN mirror, so build from the upstream release TARBALL
        // (nmap.org, valid cert) — an ARCHIVE binding, not git. C++; ships ./configure (no
        // autoreconf); BUNDLES openssl/libpcap/zlib/pcre/lua, so it builds self-contained with just a
        // C/C++ toolchain (the vendored crypto is frozen — add `openssl` + `--with-openssl=/usr` for
        // distro-tracked TLS if preferred). Static version pin, manually bumped (nmap releases ~yearly).
        nmap: {
            install: [
                { via: source  version: { static: 7.99 }
                  url: "https://nmap.org/dist/nmap-$VERSION.tar.bz2"
                  requires: [ cxx, cc, make ]
                  build: "./configure --prefix=$PREFIX && make && make install"
                  uninstall-cmd: "make uninstall" }
            ]
        }
        // iperf3: ships a committed ./configure (no autoreconf); bundles cJSON, so a C toolchain is
        // all it needs. Release tags are BARE (e.g. 3.21) -> the discovered tag is the ref, no
        // strip-v/prefix. [VERIFIED: built iperf 3.21 on fedora:41.]
        iperf3: {
            install: [
                { via: source  repo: "https://github.com/esnet/iperf"
                  version: { github: esnet/iperf }
                  requires: [ cc, make ]
                  build: "./configure --prefix=$PREFIX && make && make install"
                  uninstall-cmd: "make uninstall" }
            ]
        }
        // vnstat: ships a committed ./configure; needs sqlite (its stats DB). vX.Y tags.
        // [VERIFIED: built vnStat 2.14 on fedora:41 (sqlite-devel).]
        vnstat: {
            install: [
                { via: source  repo: "https://github.com/vergoh/vnstat"
                  version: { github: vergoh/vnstat  strip-v: true }  tag-prefix: "v"
                  requires: [ cc, make, sqlite ]
                  build: "./configure --prefix=$PREFIX && make && make install"
                  uninstall-cmd: "make uninstall" }
            ]
        }
        // jmtpfs: MTP/Android FUSE mount. Ships a committed ./configure (its OWN generated autotools,
        // NOT an autogen.sh). Needs libmtp + fuse2 + libusb + libmagic. Upstream is frozen at v0.5
        // (2016) and publishes NO github Releases, so pin the version statically (ref = tag-prefix +
        // version = v0.5). [VERIFIED: built on fedora:41.]
        jmtpfs: {
            install: [
                { via: source  version: { static: "0.5" }  tag-prefix: "v"
                  repo: "https://github.com/JasonFerrara/jmtpfs"
                  requires: [ cxx, make, pkg-config, libmtp, fuse, libusb, libmagic ]
                  build: "./configure --prefix=$PREFIX && make && make install"
                  uninstall-cmd: "make uninstall" }
            ]
        }
        // ffmpeg: custom ./configure (NOT autotools). BASELINE build — built-in codecs/muxers only
        // (no external libx264/libmp3lame/x265/...); add those libs + the matching --enable-* for a
        // fuller build. Needs nasm (x86 asm). NO github Releases (the repo is a mirror), tags are
        // `nX.Y.Z` -> static version pin + tag-prefix n. [VERIFIED: built ffmpeg on fedora:41.]
        ffmpeg: {
            install: [
                { via: source  version: { static: "8.1.2" }  tag-prefix: "n"
                  repo: "https://github.com/FFmpeg/FFmpeg"
                  requires: [ cc, make, nasm ]
                  build: "./configure --prefix=$PREFIX --disable-doc --enable-gpl && make -j$(nproc) && make install"
                  uninstall-cmd: "make uninstall" }
            ]
        }
        // socat DEFERRED — the recipe itself is fine (`autoconf` only [not autoreconf — its
        // hand-maintained config.h.in breaks autoheader], then ./configure && make; openssl +
        // readline enable those address types). But socat's only current git source is repo.or.cz
        // (the github `dest-unreach/socat1` mirror is stale, and the dest-unreach.org tarball serves
        // a self-signed cert), and a full clone from repo.or.cz is flaky from CI/containers — an
        // un-gateable, restricted-network-hostile source. Revisit if a reliable github mirror or
        // release appears.

        // ----- C++ / CMake libraries (NEW components — source-only) -----------------------------
        // Fast DDS (eProsima) — DDS/RTPS middleware (the default ROS 2 RMW). NOT in any distro repo,
        // so `source` is its ONLY install method (it builds by default — no binary alternative to
        // lose a default to). eProsima's standalone CMake install builds THREE things in order to a
        // shared prefix: foonathan_memory_vendor -> Fast-CDR -> Fast-DDS. Fast DDS does NOT bundle
        // those (the old -DTHIRDPARTY approach only ever covered Asio/TinyXML2 as git submodules,
        // which a plain clone doesn't fetch — hence the earlier build failure). So we model the two
        // eProsima libs as their own `source` components (built first via `requires:`, dependency
        // order guarantees it), and Asio + TinyXML2 + OpenSSL as native system libs (tools.hu). The
        // Fast-DDS build gets -DCMAKE_PREFIX_PATH=$PREFIX so find_package() locates the two libs we
        // built into ~/.local. NOTE: everything lands under $PREFIX/lib (~/.local/lib for a user
        // build) — put that on your loader path (LD_LIBRARY_PATH, or ldconfig for a system prefix)
        // to link/run against them. [VERIFIED: the full foonathan_memory_vendor -> Fast-CDR ->
        // Fast-DDS chain builds + installs on fedora:41 via test/run-source-builds-in-podman.sh.]
        foonathan-memory: { attrs: [ lib FOSS permissive ]
            description: "foonathan_memory (eProsima vendor build) — STL-compatible C++ memory allocators; a Fast DDS build dependency."
            install: [
                { via: source  repo: "https://github.com/eProsima/foonathan_memory_vendor"
                  version: { github: eProsima/foonathan_memory_vendor  strip-v: true }  tag-prefix: "v"
                  requires: [ cxx, cmake ]
                  build: "cmake -B build -DCMAKE_INSTALL_PREFIX=$PREFIX -DBUILD_SHARED_LIBS=ON . && cmake --build build -j$(nproc) --target install" }
            ]
        }
        fastcdr: { attrs: [ lib FOSS permissive ]
            description: "eProsima Fast CDR — a C++ library for RTPS-standard CDR serialization; a Fast DDS build dependency (also usable standalone)."
            install: [
                { via: source  repo: "https://github.com/eProsima/Fast-CDR"
                  version: { github: eProsima/Fast-CDR  strip-v: true }  tag-prefix: "v"
                  requires: [ cxx, cmake ]
                  build: "cmake -B build -DCMAKE_INSTALL_PREFIX=$PREFIX -DBUILD_SHARED_LIBS=ON . && cmake --build build -j$(nproc) --target install" }
            ]
        }
        fastdds: { attrs: [ lib FOSS permissive ]
            description: "eProsima Fast DDS — DDS/RTPS middleware (the default ROS 2 RMW)."
            install: [
                { via: source  repo: "https://github.com/eProsima/Fast-DDS"
                  version: { github: eProsima/Fast-DDS  strip-v: true }  tag-prefix: "v"
                  requires: [ cxx, cmake, openssl, asio, tinyxml2, fastcdr, foonathan-memory ]
                  build: "cmake -B build -DCMAKE_INSTALL_PREFIX=$PREFIX -DCMAKE_PREFIX_PATH=$PREFIX -DBUILD_SHARED_LIBS=ON -DCOMPILE_EXAMPLES=OFF -DBUILD_TESTING=OFF . && cmake --build build -j$(nproc) --target install" }
            ]
        }
        // XPilot NG — the classic 1990s multiplayer 2D space-combat game. No distro packages it
        // anymore (dead since ~2010), but the fork github.com/kekyo/xpilot-ng is alive again and its
        // `master` modernized the build to SDL2 + OpenGL 3.3 and fixed GCC 14/15 — so `source` is the
        // only method and it builds by default. We build the SDL client + server and DISABLE the
        // legacy X11 clients (x11-client/mapedit/replay), which need the removed Xxf86misc X.org
        // extension. Installs `xpilot-ng-sdl` (client) + `xpilot-ng-server` under $PREFIX/bin. Press
        // "Internet" in the client to pull the live server list from the metaserver (meta.xpilot.org).
        // [VERIFIED: master builds + installs on ubuntu:24.04 via the podman source-build harness.]
        // `suggests: gcc-14` (SOFT): master needs a modern GCC (>=~13; an old Debian/Ubuntu default
        // like gcc-11 on 22.04 fails to build it). On debian this installs gcc-14 via the toolchain
        // PPA; on Fedora/Arch (already GCC 14/15) the suggest simply doesn't resolve and is skipped.
        // The build then compiles with the newest gcc on PATH (gcc-14 if present, else the default).
        xpilot: { attrs: [ game app FOSS copyleft ] description: "XPilot NG — the classic multiplayer 2D space-combat game (SDL client + server)."
            suggests: gcc-14
            install: [
                { via: source  repo: "https://github.com/kekyo/xpilot-ng"  ref: master
                  requires: [ cc, make, autoconf, automake, libtool, pkg-config, expat, zlib, sdl, sdl2-ttf, sdl2-image, opengl ]
                  build: 'export CC="$(command -v gcc-14 || command -v gcc-13 || command -v gcc)"; export CXX="$(command -v g++-14 || command -v g++-13 || command -v g++)"; ( ./bootstrap || autoreconf -fi ) && ./configure --prefix=$PREFIX --disable-x11-client --disable-xp-mapedit --disable-replay && make -j$(nproc) && make install'
                  uninstall-cmd: "make uninstall" }
            ]
        }
        // EASTL (Electronic Arts) — an STL-alternative C++ template library. Only Arch (AUR) packages
        // it, so `source` is the install method on every other distro (it's the sole method there, so
        // it builds by default — correct, there's no binary alternative to lose a default to; on Arch
        // the AUR package stays the default and this is a candidate). Standalone CMake build: EASTL's
        // CMakeLists FetchContent-downloads its one dependency (EABase) at configure time, so no
        // separate dep components are needed. Installs libEASTL + the EASTL headers under $PREFIX/{lib,
        // include}. [UNVERIFIED: transcribed from EASTL's CMakeLists, not container-built.]
        eastl: {
            install: [
                { via: source  repo: "https://github.com/electronicarts/EASTL"
                  version: { github: electronicarts/EASTL }
                  requires: [ cxx, cmake, make ]
                  build: "cmake -B build -DCMAKE_INSTALL_PREFIX=$PREFIX -DEASTL_BUILD_TESTS=OFF -DEASTL_BUILD_BENCHMARK=OFF && cmake --build build -j$(nproc) && cmake --install build" }
            ]
        }
        // --- folly's C++-library dependencies (also useful standalone) ---------------------------
        // These add a `source` alternative to the native dev-lib components (tools.hu); folly (below)
        // requires them, and they're common enough to want on their own. All plain CMake with a real
        // install target; built SHARED to match the distro packages. [UNVERIFIED: transcribed from
        // each project's CMake, not container-built.]
        // fmt: bare-version tags (12.2.0). Header+lib formatting library.
        fmt: { attrs: [ lib FOSS permissive ]
            install: [
                { via: source  repo: "https://github.com/fmtlib/fmt"
                  version: { github: fmtlib/fmt }  requires: [ cxx, cmake, make ]
                  build: "cmake -B build -DCMAKE_INSTALL_PREFIX=$PREFIX -DBUILD_SHARED_LIBS=ON -DFMT_TEST=OFF -DFMT_DOC=OFF && cmake --build build -j$(nproc) && cmake --install build" }
            ]
        }
        gflags: { attrs: [ lib FOSS permissive ]
            install: [
                { via: source  repo: "https://github.com/gflags/gflags"
                  version: { github: gflags/gflags  strip-v: true }  tag-prefix: "v"  requires: [ cxx, cmake, make ]
                  build: "cmake -B build -DCMAKE_INSTALL_PREFIX=$PREFIX -DBUILD_SHARED_LIBS=ON -DGFLAGS_BUILD_TESTING=OFF && cmake --build build -j$(nproc) && cmake --install build" }
            ]
        }
        // glog: auto-detects gflags if present (folly pulls both). Tests off.
        glog: { attrs: [ lib FOSS permissive ]
            install: [
                { via: source  repo: "https://github.com/google/glog"
                  version: { github: google/glog  strip-v: true }  tag-prefix: "v"  requires: [ cxx, cmake, make ]
                  build: "cmake -B build -DCMAKE_INSTALL_PREFIX=$PREFIX -DBUILD_SHARED_LIBS=ON -DWITH_GTEST=OFF -DBUILD_TESTING=OFF && cmake --build build -j$(nproc) && cmake --install build" }
            ]
        }
        double-conversion: { attrs: [ lib FOSS permissive ]
            install: [
                { via: source  repo: "https://github.com/google/double-conversion"
                  version: { github: google/double-conversion  strip-v: true }  tag-prefix: "v"  requires: [ cxx, cmake, make ]
                  build: "cmake -B build -DCMAKE_INSTALL_PREFIX=$PREFIX -DBUILD_SHARED_LIBS=ON && cmake --build build -j$(nproc) && cmake --install build" }
            ]
        }
        // fast_float: header-only (folly REQUIREs it; it's spottily packaged, so source is the safe
        // route). `-DFASTFLOAT_INSTALL=ON` installs the headers + a CMake config package.
        fast_float: { attrs: [ lib FOSS permissive ]
            description: "fast_float — header-only C++ library for very fast string->number (from_chars) parsing."
            install: [
                { via: source  repo: "https://github.com/fastfloat/fast_float"
                  version: { github: fastfloat/fast_float  strip-v: true }  tag-prefix: "v"  requires: [ cxx, cmake, make ]
                  build: "cmake -B build -DCMAKE_INSTALL_PREFIX=$PREFIX -DFASTFLOAT_INSTALL=ON -DFASTFLOAT_TEST=OFF && cmake --install build" }
            ]
        }

        // folly (Facebook) — the reason for the deps above. Now a plain-CMake `source` recipe (NOT a
        // getdeps/bespoke-plugin): folly's CMake find_package()s its deps, so with them installed it
        // builds directly into $PREFIX. requires: pulls the codec/core set (native where the distro
        // packages it, the `source` recipes above otherwise); suggests: pulls the OPTIONAL feature
        // libs (libsodium=crypto, liburing/libaio=async IO, libunwind/libdwarf/libiberty=stack
        // symbolization) — soft, so folly skips any a distro lacks (matching folly's own auto-skip).
        // VERSION-FRAGILE: folly tracks recent boost/fmt, so an older distro (e.g. Ubuntu 22.04's
        // boost 1.74 / fmt 8) may fail cmake — build on a current distro or pin deps. Resolves on
        // debian/ubuntu/fedora/arch/alpine; on openSUSE it honestly errors — base `boost` has no
        // openSUSE binding (it splits into per-lib `-devel`s; a DEFERRED base gap).
        // [UNVERIFIED: transcribed from folly's CMake/folly-deps.cmake, not container-built.]
        folly: {
            description: "Folly — Facebook's C++ component library (Facebook Open-source Library)."
            install: [
                { via: source  repo: "https://github.com/facebook/folly"
                  version: { github: facebook/folly  strip-v: true }  tag-prefix: "v"
                  requires: [ cxx, cmake, make, boost, openssl, libevent, zlib, fmt, fast_float, gflags,
                              glog, double-conversion, libzstd, liblz4, snappy, bzip2 ]
                  suggests: [ libsodium, liburing, libaio, libunwind, libdwarf, libiberty ]   // optional folly features; soft — skipped where a distro lacks them
                  build: "cmake -B build -DCMAKE_INSTALL_PREFIX=$PREFIX -DBUILD_SHARED_LIBS=ON -DCMAKE_PREFIX_PATH=$PREFIX -DCMAKE_BUILD_TYPE=Release && cmake --build build -j$(nproc) && cmake --install build" }
            ]
        }
    }
}
