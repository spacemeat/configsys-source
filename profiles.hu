{
    // Profile amendments — where this plugin wires its source-built components INTO the profiles
    // that ship in the repo. Each entry AMENDS the lower-layer definition via `+<name>` (self-
    // include) and adds members, so:
    //   * loading configsys-source injects these components into the named profile,
    //   * removing the plugin cleanly withdraws them (the amend disappears with its layer),
    //   * your own primary-plugin / top-config amendments to the same profile still compose
    //     on top (all `+self` amends stack: repo -> here -> your primary).
    //
    // A plugin may POPULATE a profile but not ACTIVATE it — `configs:` is a machine setting and
    // stays your local choice. Name the profile exactly as the repo does (dev, web-dev, …) so the
    // `+self` term hooks the right base; a name with no lower definition just becomes a fresh
    // profile this plugin owns.
    profiles: {
        // c-cpp-libs — the source-built C/C++ APPLICATION libraries (sources.hu): folly + its deps,
        // EASTL, and the eProsima Fast DDS stack. Libraries you develop against.
        c-cpp-libs: [ folly  fmt  gflags  glog  double-conversion  fast_float  eastl  fastdds  fastcdr  foonathan-memory ]
        // c-cpp-dev-libs — the tools.hu DEV-LIBRARIES (headers + libs). The `source` recipes pull
        // these as build deps, but they're useful in their own right: compression, crypto, XML,
        // SQLite, SDL2, libcurl, the folly optional libs, and the X11 / Wayland-wlroots / XCB stacks.
        c-cpp-dev-libs: [ ncurses  libevent  openssl  zlib  asio  tinyxml2  snappy  bzip2  libzstd  liblz4
                          libsodium  liburing  libaio  libunwind  libdwarf  libiberty  libcurl  expat
                          sdl2-ttf  sdl2-image  libpcap  sqlite  libmtp  fuse  libusb  libmagic  libidn2
                          libx11  libxinerama  libxft  wayland  wayland-protocols  wlroots  libinput  libxkbcommon  pixman  cairo  pango  libxcb  xcb-util ]
        science: [ +science  fastdds ]
        suckless-tools: [ dmenu  dwm  dwl  dwmblocks  dwmblocks-async  st  somebar  someblocks ]
        // dwl is also a Wayland compositor — surface it in the repo's compositor picker (amend), not
        // just the suckless bundle above. xpilot is source-only (no base binding), so its `games`
        // profile is owned here (a fresh plugin profile; your `+games` amends compose on top).
        desktops-compositors: [ +desktops-compositors  dwl ]
        games: [ +games  xpilot ]
    }
}
