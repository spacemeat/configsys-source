{
    // Profile amendments — where this plugin wires its source-built components INTO the profiles
    // that ship in the repo. Each entry AMENDS the lower-layer definition via `+<name>` (self-
    // include) and adds members, so:
    //   * loading configsys-source injects these components into the named profile,
    //   * removing the plugin cleanly withdraws them (the amend disappears with its layer),
    //   * your own primary-plugin / top-config amendments to the same profile still compose
    //     on top (all `+self` amends stack: repo -> here -> your primary).
    //
    // A plugin may POPULATE a profile but not ACTIVATE it — `configs:` is a machine setting and
    // stays your local choice. Name the profile exactly as the repo does (dev, web-dev, …) so the
    // `+self` term hooks the right base; a name with no lower definition just becomes a fresh
    // profile this plugin owns.
    profiles: {
        // c-cpp-libs — the source-built C/C++ APPLICATION libraries (sources.hu): folly + its deps,
        // EASTL, and the eProsima Fast DDS stack. Libraries you develop against.
        c-cpp-libs: [ +c-cpp-libs  folly  fmt  gflags  glog  double-conversion  fast_float  eastl  fastdds  fastcdr  foonathan-memory ]
        // The c-cpp-dev-libs DEV-LIBRARY members (ncurses, openssl, the X11/Wayland/XCB stacks, …)
        // moved to base config.hu when their components were consolidated into base routes.hu — the
        // plugin no longer amends that profile (they're recognized on every machine, plugin or not).
        science: [ +science  fastdds ]
        // suckless-libs — the freestanding C libraries (build targets you link against). Grouped as a
        // profile for convenience; normally pulled by name or as a `requires:` of whatever needs them.
        suckless-libs: [ libgrapheme  libzahl ]
        // The runnable suckless tools. 9base is safe to bundle here — it installs under $PREFIX/plan9
        // (off PATH), so it shadows nothing. sbase/ubase are NOT here — see suckless-coreutils below.
        suckless-tools: [ dmenu  dwm  dwl  dwmblocks  dwmblocks-async  st  somebar  someblocks
                          slock  tabbed  slstatus  sent  svkbd  lsw  xssstate  surf  farbfeld
                          scron  ii  sic  smu  quark  blind  9base ]
        // suckless-coreutils — sbase (POSIX coreutils clones: ls/cat/cp/…) + ubase (Linux base utils:
        // mount/mkfs/…). These install same-named binaries into ~/.local/bin, usually EARLIER on PATH
        // than /usr/bin, so ACTIVATING this profile SHADOWS your system coreutils/util-linux with
        // feature-incomplete versions. That's the whole point of the bundle — activate it only if you
        // deliberately want the suckless userland, and NEVER `+suckless-coreutils` into a broad profile
        // (terminal/user) or you'll shadow `ls`/`cp` for everyone on it unawares.
        suckless-coreutils: [ sbase  ubase ]
        // dwl is also a Wayland compositor — surface it in the repo's compositor picker (amend), not
        // just the suckless bundle above. xpilot is source-only (no base binding), so its `games`
        // profile is owned here (a fresh plugin profile; your `+games` amends compose on top).
        desktops-compositors: [ +desktops-compositors  dwl ]
        games: [ +games  xpilot ]
    }
}
