{
    // Shared BUILD-TIME tools + dev-library capabilities the source recipes (sources.hu) pull via
    // `requires:`. These are not things you build from source — they're the toolchain — so they
    // install `via: native`, with per-distro name maps where the package name differs. Names
    // verified against current apt/dnf/pacman/apk/zypper repos (keep them honest with a name sweep
    // as repos roll). Core already provides cc/cxx (gcc/clang), cargo (rust), and make/cmake/
    // ninja/meson/go/zig; this file fills the autotools + dev-lib gaps.
    components: {

        // --- build tools (component name is the apt/zypper name; override the others) ---
        // pkg-config: Fedora ships the shim as pkgconf-pkg-config; Arch/Alpine call it pkgconf.
        pkg-config: { description: "pkg-config — query installed libraries' compile and link flags at build time."
                      install: [ { via: native  name: { dnf: pkgconf-pkg-config  pacman: pkgconf  apk: pkgconf } } ] }
        autoconf:   { description: "GNU Autoconf — generate a package's `configure` script from autotools macros."
                      install: [ { via: native } ] }   // same name on every manager
        automake:   { description: "GNU Automake — generate a portable Makefile.in from Makefile.am (autotools)."
                      install: [ { via: native } ] }
        libtool:    { description: "GNU Libtool — portable shared-library build/link wrapper (autotools)."
                      install: [ { via: native } ] }
        bison:      { description: "GNU Bison — the yacc-compatible parser generator (tmux's grammar needs it)."
                      install: [ { via: native } ] }
        flex:       { description: "flex — the fast lexical-analyzer (lexer) generator (jq's regenerated parser needs it)."
                      install: [ { via: native } ] }
        perl:       { description: "Perl — the interpreter git's default build uses for its build tooling."
                      install: [ { via: native } ] }
        nasm:       { description: "NASM — the Netwide x86/x86-64 assembler (ffmpeg needs it); same name everywhere."
                      install: [ { via: native } ] }

        // --- dev libraries (headers + libs). Debian/Fedora/openSUSE split a -dev/-devel package;
        // Arch (and the component-name default) don't split, so the base name carries headers. ---
        ncurses:  { description: "ncurses — terminal text-UI / window library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libncurses-dev  dnf: ncurses-devel   apk: ncurses-dev   zypper: ncurses-devel } } ] }
        libevent: { description: "libevent — asynchronous event-notification library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libevent-dev    dnf: libevent-devel  apk: libevent-dev  zypper: libevent-devel } } ] }
        openssl:  { description: "OpenSSL — TLS and cryptography library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libssl-dev      dnf: openssl-devel   apk: openssl-dev   zypper: libopenssl-devel } } ] }
        zlib:     { description: "zlib — the DEFLATE compression library (dev headers + libs)."
                    install: [ { via: native  name: { apt: zlib1g-dev      dnf: zlib-devel      apk: zlib-dev      zypper: zlib-devel } } ] }
        // Fast DDS build deps: Asio (async I/O) + TinyXML-2 (XML config parsing) must be present as
        // system libs — Fast DDS does NOT bundle them (foonathan_memory + Fast-CDR are built from
        // source, see sources.hu). pacman's `asio`/`tinyxml2` match the component name (default).
        // [name sweep pending for dnf/zypper/apk — the apt names are the eProsima-documented ones.]
        asio:     { description: "Asio — cross-platform C++ async I/O + networking library (header library; dev package)."
                    install: [ { via: native  name: { apt: libasio-dev     dnf: asio-devel      apk: asio-dev      zypper: asio-devel } } ] }
        tinyxml2: { description: "TinyXML-2 — a small, efficient C++ XML parser (dev headers + lib)."
                    install: [ { via: native  name: { apt: libtinyxml2-dev dnf: tinyxml2-devel  apk: tinyxml2-dev  zypper: libtinyxml2-devel } } ] }
        // C++ dev-libs for folly (also have `source` alternatives in sources.hu). Arch names verified
        // (glog = google-glog there); apt/dnf/apk/zypper are the standard lib*-dev / *-devel forms —
        // confirm with a name sweep as repos roll. `default` (component name) covers pacman where it
        // matches (fmt/gflags/double-conversion/snappy/bzip2).
        fmt:      { description: "{fmt} — modern, safe C++ text-formatting library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libfmt-dev      dnf: fmt-devel       apk: fmt-dev       zypper: fmt-devel } } ] }
        gflags:   { description: "gflags — Google's C++ command-line flags library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libgflags-dev   dnf: gflags-devel    apk: gflags-dev    zypper: gflags-devel } } ] }
        glog:     { description: "glog — Google's C++ application-logging library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libgoogle-glog-dev  dnf: glog-devel  pacman: google-glog  apk: glog-dev  zypper: glog-devel } } ] }
        double-conversion: { description: "double-conversion — Google's fast, correct binary<->decimal float conversion library."
                    install: [ { via: native  name: { apt: libdouble-conversion-dev  dnf: double-conversion-devel  apk: double-conversion-dev  zypper: double-conversion-devel } } ] }
        snappy:   { description: "Snappy — Google's fast (not maximal-ratio) compression library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libsnappy-dev   dnf: snappy-devel    apk: snappy-dev    zypper: snappy-devel } } ] }
        bzip2:    { description: "bzip2 — the Burrows-Wheeler block-sorting compression library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libbz2-dev      dnf: bzip2-devel     apk: bzip2-dev     zypper: libbz2-devel } } ] }
        // zstd/lz4 DEV libraries — distinct from base's `zstd`/`lz4` (which are the CLI tools, in the
        // `compression` bundle + required by ollama). folly links against these headers/libs.
        libzstd:  { description: "libzstd — the Zstandard compression DEV library (headers + libs; distinct from the `zstd` CLI)."
                    install: [ { via: native  name: { apt: libzstd-dev     dnf: libzstd-devel   pacman: zstd  apk: zstd-dev  zypper: libzstd-devel } } ] }
        liblz4:   { description: "liblz4 — the LZ4 fast-compression DEV library (headers + libs; distinct from the `lz4` CLI)."
                    install: [ { via: native  name: { apt: liblz4-dev      dnf: lz4-devel       pacman: lz4   apk: lz4-dev   zypper: liblz4-devel } } ] }
        // folly's OPTIONAL feature libs (folly `suggests:` these — soft, auto-skipped where a distro
        // lacks them). libsodium=crypto; liburing/libaio=async-IO event backends; libunwind/libdwarf/
        // libiberty=stack symbolization. The spotty ones are `when:`-gated so they don't resolve (and
        // so soft-skip cleanly) where unpackaged — libdwarf is AUR-only on Arch, libiberty ships inside
        // binutils outside Debian.
        libsodium: { description: "libsodium — modern, misuse-resistant cryptography library (dev headers + libs)."
                     install: [ { via: native  name: { apt: libsodium-dev  dnf: libsodium-devel  apk: libsodium-dev  zypper: libsodium-devel } } ] }
        liburing:  { description: "liburing — the io_uring asynchronous-I/O interface library (dev headers + libs)."
                     install: [ { via: native  name: { apt: liburing-dev   dnf: liburing-devel   apk: liburing-dev   zypper: liburing-devel } } ] }
        libaio:    { description: "libaio — the Linux kernel asynchronous-I/O (KAIO) library (dev headers + libs)."
                     install: [ { via: native  name: { apt: libaio-dev     dnf: libaio-devel     apk: libaio-dev     zypper: libaio-devel } } ] }
        libunwind: { description: "libunwind — call-chain unwinding for stack backtraces (dev headers + libs)."
                     install: [ { via: native  name: { apt: libunwind-dev  dnf: libunwind-devel  apk: libunwind-dev  zypper: libunwind-devel } } ] }
        libdwarf:  { description: "libdwarf — read/write DWARF debug info, for symbolized stack traces (dev headers + libs)."
                     install: [ { via: native  when: "debian or redhat or opensuse"  name: { apt: libdwarf-dev  dnf: libdwarf-devel  zypper: libdwarf-devel } } ] }
        libiberty: { description: "libiberty — GNU utility routines (C++ symbol demangling, etc.) used for symbolization."
                     install: [ { via: native  when: "debian"  name: libiberty-dev } ] }
        libcurl:  { description: "libcurl — the multi-protocol URL-transfer DEV library (headers + libs)."
                    install: [ { via: native  name: { apt: libcurl4-openssl-dev  dnf: libcurl-devel  pacman: curl  apk: curl-dev  zypper: libcurl-devel } } ] }
        expat:    { description: "Expat — a fast stream-oriented XML parser library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libexpat1-dev   dnf: expat-devel     pacman: expat  apk: expat-dev    zypper: libexpat-devel } } ] }
        // SDL2 add-on dev libs (core `sdl` is SDL2 proper). Used by the xpilot source recipe.
        sdl2-ttf:   { description: "SDL2_ttf — TrueType font rendering for SDL2 (dev headers + libs)."
                      install: [ { via: native  name: { apt: libsdl2-ttf-dev    dnf: SDL2_ttf-devel    pacman: sdl2_ttf    apk: sdl2_ttf-dev    zypper: libSDL2_ttf-devel } } ] }
        sdl2-image: { description: "SDL2_image — image-file loading for SDL2 (dev headers + libs)."
                      install: [ { via: native  name: { apt: libsdl2-image-dev  dnf: SDL2_image-devel  pacman: sdl2_image  apk: sdl2_image-dev  zypper: libSDL2_image-devel } } ] }
        gettext:  { description: "GNU gettext — internationalization message tools (msgfmt) and the libintl runtime."
                    install: [ { via: native  name: { apk: gettext-dev     zypper: gettext-tools } } ] }
        libpcap:  { description: "libpcap — the packet-capture library (nethogs needs it)."
                    install: [ { via: native  name: { apt: libpcap-dev     dnf: libpcap-devel   apk: libpcap-dev  zypper: libpcap-devel } } ] }
        sqlite:   { description: "SQLite — the embedded SQL database engine DEV library (headers + libs)."
                    install: [ { via: native  name: { apt: libsqlite3-dev  dnf: sqlite-devel    pacman: sqlite  apk: sqlite-dev  zypper: sqlite3-devel } } ] }
        libmtp:   { description: "libMTP — Media Transfer Protocol library for phones/players (jmtpfs needs it)."
                    install: [ { via: native  name: { apt: libmtp-dev      dnf: libmtp-devel    apk: libmtp-dev   zypper: libmtp-devel } } ] }
        fuse:     { description: "FUSE 2 — Filesystem-in-Userspace library (jmtpfs needs it)."
                    install: [ { via: native  name: { apt: libfuse-dev     dnf: fuse-devel      pacman: fuse2   apk: fuse-dev    zypper: fuse-devel } } ] }
        libusb:   { description: "libusb — cross-platform userspace USB device-access library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libusb-1.0-0-dev  dnf: libusb1-devel  pacman: libusb  apk: libusb-dev  zypper: libusb-1_0-devel } } ] }
        libmagic: { description: "libmagic — the file-type detection library behind `file` (jmtpfs needs it)."
                    install: [ { via: native  name: { apt: libmagic-dev    dnf: file-devel      pacman: file    apk: file-dev    zypper: file-devel } } ] }
        libidn2:  { description: "libidn2 — Internationalized Domain Names (IDNA2008) library (whois needs it)."
                    install: [ { via: native  name: { apt: libidn2-dev     dnf: libidn2-devel   apk: libidn2-dev  zypper: libidn2-devel } } ] }
    }
}
