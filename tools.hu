{
    // Shared BUILD-TIME tools + dev-library capabilities the source recipes (sources.hu) pull via
    // `requires:`. These are not things you build from source — they're the toolchain — so they
    // install `via: native`, with per-distro name maps where the package name differs. Names
    // verified against current apt/dnf/pacman/apk/zypper repos (keep them honest with a name sweep
    // as repos roll). Core already provides cc/cxx (gcc/clang), cargo (rust), and make/cmake/
    // ninja/meson/go/zig; this file fills the autotools + dev-lib gaps.
    components: {

        // NOTE: the autotools/GNU C build tools (pkg-config, autoconf, automake, libtool, bison,
        // flex) plus perl and nasm now live in BASE routes.hu (under the `autotools` profile) — they
        // are basic C-dev tools, not source-build recipes. The recipes below `requires:` them by
        // name and resolve them from base. Only the dev LIBRARIES specific to these recipes stay here.

        // --- dev libraries (headers + libs). Debian/Fedora/openSUSE split a -dev/-devel package;
        // Arch (and the component-name default) don't split, so the base name carries headers. ---
        ncurses:  { attrs: [ lib FOSS permissive ] description: "ncurses — terminal text-UI / window library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libncurses-dev  dnf: ncurses-devel   apk: ncurses-dev   zypper: ncurses-devel } } ] }
        libevent: { attrs: [ lib FOSS permissive ] description: "libevent — asynchronous event-notification library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libevent-dev    dnf: libevent-devel  apk: libevent-dev  zypper: libevent-devel } } ] }
        openssl:  { attrs: [ lib FOSS permissive ] description: "OpenSSL — TLS and cryptography library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libssl-dev      dnf: openssl-devel   apk: openssl-dev   zypper: libopenssl-devel } } ] }
        zlib:     { attrs: [ lib FOSS permissive ] description: "zlib — the DEFLATE compression library (dev headers + libs)."
                    install: [ { via: native  name: { apt: zlib1g-dev      dnf: zlib-devel      apk: zlib-dev      zypper: zlib-devel } } ] }
        // Fast DDS build deps: Asio (async I/O) + TinyXML-2 (XML config parsing) must be present as
        // system libs — Fast DDS does NOT bundle them (foonathan_memory + Fast-CDR are built from
        // source, see sources.hu). pacman's `asio`/`tinyxml2` match the component name (default).
        // [name sweep pending for dnf/zypper/apk — the apt names are the eProsima-documented ones.]
        asio:     { attrs: [ lib FOSS permissive ] description: "Asio — cross-platform C++ async I/O + networking library (header library; dev package)."
                    install: [ { via: native  name: { apt: libasio-dev     dnf: asio-devel      apk: asio-dev      zypper: asio-devel } } ] }
        tinyxml2: { attrs: [ lib FOSS permissive ] description: "TinyXML-2 — a small, efficient C++ XML parser (dev headers + lib)."
                    install: [ { via: native  name: { apt: libtinyxml2-dev dnf: tinyxml2-devel  apk: tinyxml2-dev  zypper: libtinyxml2-devel } } ] }
        // C++ dev-libs for folly (also have `source` alternatives in sources.hu). Arch names verified
        // (glog = google-glog there); apt/dnf/apk/zypper are the standard lib*-dev / *-devel forms —
        // confirm with a name sweep as repos roll. `default` (component name) covers pacman where it
        // matches (fmt/gflags/double-conversion/snappy/bzip2).
        fmt:      { description: "{fmt} — modern, safe C++ text-formatting library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libfmt-dev      dnf: fmt-devel       apk: fmt-dev       zypper: fmt-devel } } ] }
        gflags:   { description: "gflags — Google's C++ command-line flags library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libgflags-dev   dnf: gflags-devel    apk: gflags-dev    zypper: gflags-devel } } ] }
        glog:     { description: "glog — Google's C++ application-logging library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libgoogle-glog-dev  dnf: glog-devel  pacman: google-glog  apk: glog-dev  zypper: glog-devel } } ] }
        double-conversion: { description: "double-conversion — Google's fast, correct binary<->decimal float conversion library."
                    install: [ { via: native  name: { apt: libdouble-conversion-dev  dnf: double-conversion-devel  apk: double-conversion-dev  zypper: double-conversion-devel } } ] }
        snappy:   { attrs: [ lib FOSS permissive ] description: "Snappy — Google's fast (not maximal-ratio) compression library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libsnappy-dev   dnf: snappy-devel    apk: snappy-dev    zypper: snappy-devel } } ] }
        bzip2:    { attrs: [ lib FOSS permissive ] description: "bzip2 — the Burrows-Wheeler block-sorting compression library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libbz2-dev      dnf: bzip2-devel     apk: bzip2-dev     zypper: libbz2-devel } } ] }
        // zstd/lz4 DEV libraries — distinct from base's `zstd`/`lz4` (which are the CLI tools, in the
        // `compression` bundle + required by ollama). folly links against these headers/libs.
        libzstd:  { attrs: [ lib FOSS permissive ] description: "libzstd — the Zstandard compression DEV library (headers + libs; distinct from the `zstd` CLI)."
                    install: [ { via: native  name: { apt: libzstd-dev     dnf: libzstd-devel   pacman: zstd  apk: zstd-dev  zypper: libzstd-devel } } ] }
        liblz4:   { attrs: [ lib FOSS permissive ] description: "liblz4 — the LZ4 fast-compression DEV library (headers + libs; distinct from the `lz4` CLI)."
                    install: [ { via: native  name: { apt: liblz4-dev      dnf: lz4-devel       pacman: lz4   apk: lz4-dev   zypper: liblz4-devel } } ] }
        // folly's OPTIONAL feature libs (folly `suggests:` these — soft, auto-skipped where a distro
        // lacks them). libsodium=crypto; liburing/libaio=async-IO event backends; libunwind/libdwarf/
        // libiberty=stack symbolization. The spotty ones are `when:`-gated so they don't resolve (and
        // so soft-skip cleanly) where unpackaged — libdwarf is AUR-only on Arch, libiberty ships inside
        // binutils outside Debian.
        libsodium: { attrs: [ lib FOSS permissive ] description: "libsodium — modern, misuse-resistant cryptography library (dev headers + libs)."
                     install: [ { via: native  name: { apt: libsodium-dev  dnf: libsodium-devel  apk: libsodium-dev  zypper: libsodium-devel } } ] }
        liburing:  { attrs: [ lib FOSS permissive ] description: "liburing — the io_uring asynchronous-I/O interface library (dev headers + libs)."
                     install: [ { via: native  name: { apt: liburing-dev   dnf: liburing-devel   apk: liburing-dev   zypper: liburing-devel } } ] }
        libaio:    { attrs: [ lib FOSS copyleft ] description: "libaio — the Linux kernel asynchronous-I/O (KAIO) library (dev headers + libs)."
                     install: [ { via: native  name: { apt: libaio-dev     dnf: libaio-devel     apk: libaio-dev     zypper: libaio-devel } } ] }
        libunwind: { attrs: [ lib FOSS permissive ] description: "libunwind — call-chain unwinding for stack backtraces (dev headers + libs)."
                     install: [ { via: native  name: { apt: libunwind-dev  dnf: libunwind-devel  apk: libunwind-dev  zypper: libunwind-devel } } ] }
        libdwarf:  { attrs: [ lib FOSS copyleft ] description: "libdwarf — read/write DWARF debug info, for symbolized stack traces (dev headers + libs)."
                     install: [ { via: native  when: "debian or redhat or opensuse"  name: { apt: libdwarf-dev  dnf: libdwarf-devel  zypper: libdwarf-devel } } ] }
        libiberty: { attrs: [ lib FOSS GNU copyleft ] description: "libiberty — GNU utility routines (C++ symbol demangling, etc.) used for symbolization."
                     install: [ { via: native  when: "debian"  name: libiberty-dev } ] }
        libcurl:  { attrs: [ lib FOSS permissive ] description: "libcurl — the multi-protocol URL-transfer DEV library (headers + libs)."
                    install: [ { via: native  name: { apt: libcurl4-openssl-dev  dnf: libcurl-devel  pacman: curl  apk: curl-dev  zypper: libcurl-devel } } ] }
        expat:    { attrs: [ lib FOSS permissive ] description: "Expat — a fast stream-oriented XML parser library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libexpat1-dev   dnf: expat-devel     pacman: expat  apk: expat-dev    zypper: libexpat-devel } } ] }
        // SDL2 add-on dev libs (core `sdl` is SDL2 proper). Used by the xpilot source recipe.
        sdl2-ttf:   { attrs: [ lib FOSS permissive ] description: "SDL2_ttf — TrueType font rendering for SDL2 (dev headers + libs)."
                      install: [ { via: native  name: { apt: libsdl2-ttf-dev    dnf: SDL2_ttf-devel    pacman: sdl2_ttf    apk: sdl2_ttf-dev    zypper: libSDL2_ttf-devel } } ] }
        sdl2-image: { attrs: [ lib FOSS permissive ] description: "SDL2_image — image-file loading for SDL2 (dev headers + libs)."
                      install: [ { via: native  name: { apt: libsdl2-image-dev  dnf: SDL2_image-devel  pacman: sdl2_image  apk: sdl2_image-dev  zypper: libSDL2_image-devel } } ] }
        gettext:  { attrs: [ CLI FOSS GNU copyleft ] description: "GNU gettext — internationalization message tools (msgfmt) and the libintl runtime."
                    install: [ { via: native  name: { apk: gettext-dev     zypper: gettext-tools } } ] }
        libpcap:  { attrs: [ lib FOSS permissive ] description: "libpcap — the packet-capture library (nethogs needs it)."
                    install: [ { via: native  name: { apt: libpcap-dev     dnf: libpcap-devel   apk: libpcap-dev  zypper: libpcap-devel } } ] }
        sqlite:   { attrs: [ lib FOSS permissive ] description: "SQLite — the embedded SQL database engine DEV library (headers + libs)."
                    install: [ { via: native  name: { apt: libsqlite3-dev  dnf: sqlite-devel    pacman: sqlite  apk: sqlite-dev  zypper: sqlite3-devel } } ] }
        libmtp:   { attrs: [ lib FOSS copyleft ] description: "libMTP — Media Transfer Protocol library for phones/players (jmtpfs needs it)."
                    install: [ { via: native  name: { apt: libmtp-dev      dnf: libmtp-devel    apk: libmtp-dev   zypper: libmtp-devel } } ] }
        fuse:     { attrs: [ lib FOSS copyleft ] description: "FUSE 2 — Filesystem-in-Userspace library (jmtpfs needs it)."
                    install: [ { via: native  name: { apt: libfuse-dev     dnf: fuse-devel      pacman: fuse2   apk: fuse-dev    zypper: fuse-devel } } ] }
        libusb:   { attrs: [ lib FOSS copyleft ] description: "libusb — cross-platform userspace USB device-access library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libusb-1.0-0-dev  dnf: libusb1-devel  pacman: libusb  apk: libusb-dev  zypper: libusb-1_0-devel } } ] }
        libmagic: { attrs: [ lib FOSS permissive ] description: "libmagic — the file-type detection library behind `file` (jmtpfs needs it)."
                    install: [ { via: native  name: { apt: libmagic-dev    dnf: file-devel      pacman: file    apk: file-dev    zypper: file-devel } } ] }
        libidn2:  { attrs: [ lib FOSS GNU copyleft ] description: "libidn2 — Internationalized Domain Names (IDNA2008) library (whois needs it)."
                    install: [ { via: native  name: { apt: libidn2-dev     dnf: libidn2-devel   apk: libidn2-dev  zypper: libidn2-devel } } ] }

        // --- X11 dev libs (for the suckless source builds: dwm/st/dmenu/dwmblocks). pacman ships the
        // headers in the base lib package (no -dev split), so `default:` = the bare name for Arch. ---
        libx11:      { attrs: [ lib FOSS permissive ] description: "libX11 — the core X11 client library (dev headers + libs)."
                       install: [ { via: native  name: { apt: libx11-dev  dnf: libX11-devel  apk: libx11-dev  zypper: libX11-devel  default: libx11 } } ] }
        libxinerama: { attrs: [ lib FOSS permissive ] description: "libXinerama — the X11 multi-monitor (Xinerama) extension library (dev headers + libs)."
                       install: [ { via: native  name: { apt: libxinerama-dev  dnf: libXinerama-devel  apk: libxinerama-dev  zypper: libXinerama-devel  default: libxinerama } } ] }
        libxft:      { attrs: [ lib FOSS permissive ] description: "libXft — the X11 FreeType font-rendering library (dev headers + libs)."
                       install: [ { via: native  name: { apt: libxft-dev  dnf: libXft-devel  apk: libxft-dev  zypper: libXft-devel  default: libxft } } ] }

        // --- Wayland/wlroots dev libs (for the dwl source stack: dwl/somebar/someblocks). ---
        wayland:           { attrs: [ lib FOSS permissive ] description: "Wayland — the core Wayland client/server library + scanner (dev headers + libs)."
                             install: [ { via: native  name: { apt: libwayland-dev  dnf: wayland-devel  apk: wayland-dev  zypper: wayland-devel  default: wayland } } ] }
        wayland-protocols: { attrs: [ lib FOSS permissive ] description: "wayland-protocols — the standard Wayland protocol XML definitions."
                             install: [ { via: native  name: { apt: wayland-protocols  dnf: wayland-protocols-devel  apk: wayland-protocols  zypper: wayland-protocols-devel  default: wayland-protocols } } ] }
        // wlroots: dwl pins a specific wlroots MINOR per release, and distros VERSION the package
        // (Arch has no bare `wlroots` — it ships `wlroots0.20`, previously `wlroots0.19`). Bump the
        // pacman name as Arch rolls, and match it to the wlroots your dwl `ref:` wants, or the build
        // fails (dwl master currently needs 0.19 while Arch is on 0.20 — a known mismatch).
        wlroots:           { attrs: [ lib FOSS permissive ] description: "wlroots — the modular Wayland compositor library (dev headers + libs)."
                             install: [ { via: native  name: { apt: libwlroots-dev  dnf: wlroots-devel  apk: wlroots-dev  zypper: wlroots-devel  pacman: wlroots0.20 } } ] }
        libinput:          { attrs: [ lib FOSS permissive ] description: "libinput — the input-device handling library for Wayland/X (dev headers + libs)."
                             install: [ { via: native  name: { apt: libinput-dev  dnf: libinput-devel  apk: libinput-dev  zypper: libinput-devel  default: libinput } } ] }
        libxkbcommon:      { attrs: [ lib FOSS permissive ] description: "libxkbcommon — the keyboard keymap handling library (dev headers + libs)."
                             install: [ { via: native  name: { apt: libxkbcommon-dev  dnf: libxkbcommon-devel  apk: libxkbcommon-dev  zypper: libxkbcommon-devel  default: libxkbcommon } } ] }
        pixman:            { attrs: [ lib FOSS permissive ] description: "pixman — the low-level pixel-manipulation library (dev headers + libs)."
                             install: [ { via: native  name: { apt: libpixman-1-dev  dnf: pixman-devel  apk: pixman-dev  zypper: libpixman-1-0-devel  default: pixman } } ] }
        cairo:             { attrs: [ lib FOSS copyleft ] description: "cairo — the 2D vector-graphics rendering library (dev headers + libs)."
                             install: [ { via: native  name: { apt: libcairo2-dev  dnf: cairo-devel  apk: cairo-dev  zypper: cairo-devel  default: cairo } } ] }
        pango:             { attrs: [ lib FOSS copyleft ] description: "Pango — the text-layout and font-rendering library (dev headers + libs)."
                             install: [ { via: native  name: { apt: libpango1.0-dev  dnf: pango-devel  apk: pango-dev  zypper: pango-devel  default: pango } } ] }
        // XCB (for dwmblocks-async). xcb-util provides the `xcb-atom` pkg-config it links (Arch name
        // verified; other managers' -util names are best-effort — confirm with a name sweep).
        libxcb:            { attrs: [ lib FOSS permissive ] description: "libxcb — the X protocol C-language Binding (XCB) library (dev headers + libs)."
                             install: [ { via: native  name: { apt: libxcb1-dev  dnf: libxcb-devel  apk: libxcb-dev  zypper: libxcb-devel  default: libxcb } } ] }
        xcb-util:          { attrs: [ lib FOSS permissive ] description: "xcb-util — XCB utility libraries (atom/aux/event helpers; dev headers + libs)."
                             install: [ { via: native  name: { apt: libxcb-util-dev  dnf: xcb-util-devel  apk: xcb-util-dev  zypper: xcb-util-devel  default: xcb-util } } ] }
    }
}
