{
    // Shared BUILD-TIME tools + dev-library capabilities the source recipes (sources.hu) pull via
    // `requires:`. These are not things you build from source — they're the toolchain — so they
    // install `via: native`, with per-distro name maps where the package name differs. Names
    // verified against current apt/dnf/pacman/apk/zypper repos (keep them honest with a name sweep
    // as repos roll). Core already provides cc/cxx (gcc/clang), cargo (rust), and make/cmake/
    // ninja/meson/go/zig; this file fills the autotools + dev-lib gaps.
    components: {

        // --- build tools (component name is the apt/zypper name; override the others) ---
        // pkg-config: Fedora ships the shim as pkgconf-pkg-config; Arch/Alpine call it pkgconf.
        pkg-config: { install: [ { via: native  name: { dnf: pkgconf-pkg-config  pacman: pkgconf  apk: pkgconf } } ] }
        autoconf:   { install: [ { via: native } ] }   // same name on every manager
        automake:   { install: [ { via: native } ] }
        libtool:    { install: [ { via: native } ] }
        bison:      { install: [ { via: native } ] }   // the yacc a few grammars (tmux) need
        flex:       { install: [ { via: native } ] }   // the lexer jq's regenerated parser needs
        perl:       { install: [ { via: native } ] }   // git's default build compiles perl tooling
        nasm:       { install: [ { via: native } ] }   // x86 assembler (ffmpeg); same name everywhere

        // --- dev libraries (headers + libs). Debian/Fedora/openSUSE split a -dev/-devel package;
        // Arch (and the component-name default) don't split, so the base name carries headers. ---
        ncurses:  { install: [ { via: native  name: { apt: libncurses-dev  dnf: ncurses-devel   apk: ncurses-dev   zypper: ncurses-devel } } ] }
        libevent: { install: [ { via: native  name: { apt: libevent-dev    dnf: libevent-devel  apk: libevent-dev  zypper: libevent-devel } } ] }
        openssl:  { install: [ { via: native  name: { apt: libssl-dev      dnf: openssl-devel   apk: openssl-dev   zypper: libopenssl-devel } } ] }
        zlib:     { install: [ { via: native  name: { apt: zlib1g-dev      dnf: zlib-devel      apk: zlib-dev      zypper: zlib-devel } } ] }
        // C++ dev-libs for folly (also have `source` alternatives in sources.hu). Arch names verified
        // (glog = google-glog there); apt/dnf/apk/zypper are the standard lib*-dev / *-devel forms —
        // confirm with a name sweep as repos roll. `default` (component name) covers pacman where it
        // matches (fmt/gflags/double-conversion/snappy/bzip2).
        fmt:      { install: [ { via: native  name: { apt: libfmt-dev      dnf: fmt-devel       apk: fmt-dev       zypper: fmt-devel } } ] }
        gflags:   { install: [ { via: native  name: { apt: libgflags-dev   dnf: gflags-devel    apk: gflags-dev    zypper: gflags-devel } } ] }
        glog:     { install: [ { via: native  name: { apt: libgoogle-glog-dev  dnf: glog-devel  pacman: google-glog  apk: glog-dev  zypper: glog-devel } } ] }
        double-conversion: { install: [ { via: native  name: { apt: libdouble-conversion-dev  dnf: double-conversion-devel  apk: double-conversion-dev  zypper: double-conversion-devel } } ] }
        snappy:   { install: [ { via: native  name: { apt: libsnappy-dev   dnf: snappy-devel    apk: snappy-dev    zypper: snappy-devel } } ] }
        bzip2:    { install: [ { via: native  name: { apt: libbz2-dev      dnf: bzip2-devel     apk: bzip2-dev     zypper: libbz2-devel } } ] }
        // zstd/lz4 DEV libraries — distinct from base's `zstd`/`lz4` (which are the CLI tools, in the
        // `compression` bundle + required by ollama). folly links against these headers/libs.
        libzstd:  { install: [ { via: native  name: { apt: libzstd-dev     dnf: libzstd-devel   pacman: zstd  apk: zstd-dev  zypper: libzstd-devel } } ] }
        liblz4:   { install: [ { via: native  name: { apt: liblz4-dev      dnf: lz4-devel       pacman: lz4   apk: lz4-dev   zypper: liblz4-devel } } ] }
        // folly's OPTIONAL feature libs (folly `suggests:` these — soft, auto-skipped where a distro
        // lacks them). libsodium=crypto; liburing/libaio=async-IO event backends; libunwind/libdwarf/
        // libiberty=stack symbolization. The spotty ones are `when:`-gated so they don't resolve (and
        // so soft-skip cleanly) where unpackaged — libdwarf is AUR-only on Arch, libiberty ships inside
        // binutils outside Debian.
        libsodium: { install: [ { via: native  name: { apt: libsodium-dev  dnf: libsodium-devel  apk: libsodium-dev  zypper: libsodium-devel } } ] }
        liburing:  { install: [ { via: native  name: { apt: liburing-dev   dnf: liburing-devel   apk: liburing-dev   zypper: liburing-devel } } ] }
        libaio:    { install: [ { via: native  name: { apt: libaio-dev     dnf: libaio-devel     apk: libaio-dev     zypper: libaio-devel } } ] }
        libunwind: { install: [ { via: native  name: { apt: libunwind-dev  dnf: libunwind-devel  apk: libunwind-dev  zypper: libunwind-devel } } ] }
        libdwarf:  { install: [ { via: native  when: "debian or redhat or opensuse"  name: { apt: libdwarf-dev  dnf: libdwarf-devel  zypper: libdwarf-devel } } ] }
        libiberty: { install: [ { via: native  when: "debian"  name: libiberty-dev } ] }
        libcurl:  { install: [ { via: native  name: { apt: libcurl4-openssl-dev  dnf: libcurl-devel  pacman: curl  apk: curl-dev  zypper: libcurl-devel } } ] }
        expat:    { install: [ { via: native  name: { apt: libexpat1-dev   dnf: expat-devel     pacman: expat  apk: expat-dev    zypper: libexpat-devel } } ] }
        gettext:  { install: [ { via: native  name: { apk: gettext-dev     zypper: gettext-tools } } ] }   // msgfmt/libintl for i18n
        libpcap:  { install: [ { via: native  name: { apt: libpcap-dev     dnf: libpcap-devel   apk: libpcap-dev  zypper: libpcap-devel } } ] }   // packet capture (nethogs)
        sqlite:   { install: [ { via: native  name: { apt: libsqlite3-dev  dnf: sqlite-devel    pacman: sqlite  apk: sqlite-dev  zypper: sqlite3-devel } } ] }
        libmtp:   { install: [ { via: native  name: { apt: libmtp-dev      dnf: libmtp-devel    apk: libmtp-dev   zypper: libmtp-devel } } ] }        // MTP (jmtpfs)
        fuse:     { install: [ { via: native  name: { apt: libfuse-dev     dnf: fuse-devel      pacman: fuse2   apk: fuse-dev    zypper: fuse-devel } } ] }        // FUSE 2 (jmtpfs)
        libusb:   { install: [ { via: native  name: { apt: libusb-1.0-0-dev  dnf: libusb1-devel  pacman: libusb  apk: libusb-dev  zypper: libusb-1_0-devel } } ] }
        libmagic: { install: [ { via: native  name: { apt: libmagic-dev    dnf: file-devel      pacman: file    apk: file-dev    zypper: file-devel } } ] }        // libmagic/file-type (jmtpfs)
        libidn2:  { install: [ { via: native  name: { apt: libidn2-dev     dnf: libidn2-devel   apk: libidn2-dev  zypper: libidn2-devel } } ] }        // IDN (whois)
    }
}
