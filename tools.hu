{
    // The shared build-dep dev libraries that used to live here (ncurses, openssl, zlib, the folly
    // deps, the X11/Wayland/XCB libs, cairo/pango, SDL2 add-ons, …) were CONSOLIDATED INTO BASE
    // routes.hu — any component can `requires:` them now, and they're recognized by the orphan scan
    // on every machine, not just where this plugin is synced. The source recipes in sources.hu /
    // desktop.hu reference them by the SAME names, resolved from core.
    //
    // The autotools/GNU C build tools (pkg-config, autoconf, automake, libtool, bison, flex, perl,
    // nasm) live in base routes.hu too (the `autotools` profile). Add a plugin-only build dep here
    // only if a recipe needs one that base doesn't provide.
    components: { }
}
