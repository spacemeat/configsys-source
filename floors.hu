{
    // AUTO-DERIVED toolchain floors for this plugin's source recipes — regenerate with
    //   tools/versionsweep.py --derive   (reads each recipe's built-tag Cargo.toml / go.mod)
    // as upstreams bump their MSRV / go.mod. `version-floors:` patches the floor onto each recipe's
    // source binding WITHOUT redefining it (it only tightens the existing cargo/go requirement), so
    // configsys can advise/auto-select a toolchain that meets it. Values reflect the current release
    // tag each recipe builds; they will drift — the daily sweep keeps them honest.
    //
    // (htop/tmux build with the native cc/make toolchain, which has no version floor to derive.)
    version-floors: {
        ripgrep:   { cargo: ">=1.85" }
        lazygit:   { go: ">=1.25.0" }
        superfile: { go: ">=1.25.7" }
    }
}
